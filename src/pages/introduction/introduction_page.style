#page-content {
    #pages-list {
        margin-top: 2px;
        vertical: true;
    }
}

#page-content label {
    width: 200px;
    text-wrap: wrapped;
}

#myList>button {
    &:clicked {
        padding: 100px;
        border: 2px;
        text-color: #ff0000;
        border-color: #ff0000;
    }
}

#myList>button label {
    background-color: #ff0000;
    &:hovered {
        background-color: #0000ff;
    }
}

#myList>* label {
    text-color: #00ff00;
}

// FIXME: it lacks one background height pixel on "back to index" button (when hovered) when not in index page