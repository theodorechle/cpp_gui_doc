#root-page {
    width: 500px;
    height: 500px;
    background-color: #ffffff;
    vertical: true;

    #header-list {
        border-bottom: 1px;
        childs-size: keep;
        // height: 40px;

        >* {
            vertical-alignment: centered;
            // height: 100px;
        }

        .back-button {
            // width: 30px;
            border-right: 1px;
        }

        #page-name {
            padding-left: 150px;
            padding-right: 250px;
            // horizontal-alignment: centered;
        }
    }

    #page-content {
        width: 500px;
        height: 500px;
    }
}

label, input {
    font-name: "Courgette-Regular.ttf";
    font-weight: 12px;
}

button {
    &:hovered {
        background-color: #3838bb;
        text-color: #ffffff;
        // font-size: 50px;
    }
}

input {
    width: 200px;
    height: 50px;
        border: 1px;
        border-color: #000000;

&:focused {
    background-color: #ffff00;
}
}