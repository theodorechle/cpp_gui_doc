#root-page {
    width: 500px;
    height: 500px;
    background-color: #ffffff;
    vertical: true;

    #header-list {
        border-bottom: 1px;
        childs-size: keep;
        // height: 40px;

        >* {
            vertical-alignment: centered;
            // height: 100px;
        }

        .back-button {
            // width: 30px;
            border-right: 1px;
        }

        #page-name {
            padding-left: 150px;
            padding-right: 250px;
            // horizontal-alignment: centered;
        }
    }

    #page-content {
        width: 500px;
        height: 500px;
    }
}

label {
    font-name: "Roboto-VariableFont_wdth,wght.ttf";
    font-size: 50px;
    font-weight: 12px;
}

button {
    &:hovered {
        background-color: #0000ff;
    }
}