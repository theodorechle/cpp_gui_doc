#root-page {
    width: 500px;
    height: 500px;
    background-color: #ffffff;
    vertical: true;

    #header-list {
        border-bottom: 1px;
        width: 300px;

        >* {
            vertical-alignment: centered;
        }

        .back-button {
            border-right: 1px;
        }

        #page-name {
            horizontal-alignement: centered;
        }
    }

    #page-content {
        width: 500px;
        height: 500px;
    }
}

label, input {
    font-name: "Courgette-Regular.ttf";
    font-weight: 12px;
}

button {
    &:hovered {
        background-color: #3838bb;
        text-color: #ffffff;
    }
}

input {
    width: 200px;
    height: 50px;
        border: 1px;
        border-color: #000000;

    &:focused {
        background-color: #ffff00;
    }
}